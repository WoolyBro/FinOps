# --- Model provider -------------------------------------------------------
# auto (default) | bedrock | ollama
#   bedrock -> production. Claude on Amazon Bedrock.
#   ollama  -> local development without AWS.
#   auto    -> bedrock if AWS credentials resolve, else ollama if it is running.
FF_MODEL_PROVIDER=auto
# Override the model id if you want a different one.
# FF_MODEL_ID=global.anthropic.claude-sonnet-4-6

# --- Amazon Bedrock -------------------------------------------------------
AWS_REGION=us-east-1
# Credentials come from `aws configure`, an SSO profile, or an IAM role.

# --- Ollama (local development) -------------------------------------------
# OLLAMA_HOST=http://localhost:11434
# FF_MODEL_ID=llama3.1

# --- Business identity printed on invoices --------------------------------
FF_BUSINESS_NAME=Your Name
FF_BUSINESS_EMAIL=you@example.com
FF_BUSINESS_PHONE=+91 98765 43210
FF_BUSINESS_ADDRESS=City, State PIN, Country
FF_CURRENCY=INR
FF_INVOICE_PREFIX=FF
FF_RECEIPT_PREFIX=RC
