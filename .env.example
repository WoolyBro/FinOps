# --- Model provider -------------------------------------------------------
# auto (default) | bedrock | anthropic | ollama
FF_MODEL_PROVIDER=auto
# Override the model id if you want a different one.
# FF_MODEL_ID=global.anthropic.claude-sonnet-4-6

# --- Amazon Bedrock -------------------------------------------------------
AWS_REGION=us-east-1
# Credentials come from `aws configure`, an SSO profile, or an IAM role.

# --- Anthropic API (fallback while AWS access is pending) -----------------
# ANTHROPIC_API_KEY=sk-ant-...

# --- Business identity printed on invoices --------------------------------
FF_BUSINESS_NAME=Your Name
FF_BUSINESS_EMAIL=you@example.com
FF_CURRENCY=INR
FF_INVOICE_PREFIX=FF
FF_RECEIPT_PREFIX=RC
