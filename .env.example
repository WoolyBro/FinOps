# --- Model provider -------------------------------------------------------
# auto (default) | gemini | bedrock | ollama
#   gemini  -> Google Gemini (gemini-3.6-flash). Needs GEMINI_API_KEY below.
#   bedrock -> Amazon Nova on Amazon Bedrock.
#   ollama  -> a local model.
#   auto    -> gemini if a key is set, else bedrock if AWS credentials
#              resolve, else ollama if it is running.
FF_MODEL_PROVIDER=auto
# Override the provider's default model id.
# FF_MODEL_ID=gemini-3.6-flash

# --- Google Gemini --------------------------------------------------------
# Free key: https://aistudio.google.com/apikey  (never commit it -- .env is
# gitignored). On the free tier Google may use prompts to improve its models,
# so use demo data, not real client records.
GEMINI_API_KEY=

# --- Amazon Bedrock -------------------------------------------------------
# Explicit and required for Bedrock. Model access is enabled per region, so an
# inherited region turns a missing grant into an opaque AccessDenied later.
FF_AWS_REGION=ap-south-1
# Credentials come from `aws configure`, an SSO profile, or an IAM role.

# --- AgentCore Runtime ----------------------------------------------------
# Set to true ONLY when the database is on genuinely shared, durable storage.
# On a default AgentCore deployment the microVM filesystem is per-session and
# ephemeral -- see docs/AGENTCORE.md.
# FF_STORAGE_DURABLE=false
# FF_LOG_LEVEL=INFO

# --- Ollama (local development) -------------------------------------------
# OLLAMA_HOST=http://localhost:11434
# FF_MODEL_ID=llama3.1

# --- Business identity printed on invoices --------------------------------
FF_BUSINESS_NAME=Your Name
FF_BUSINESS_EMAIL=you@example.com
FF_BUSINESS_PHONE=+91 98765 43210
FF_BUSINESS_ADDRESS=City, State PIN, Country
FF_CURRENCY=INR
FF_INVOICE_PREFIX=FF
FF_RECEIPT_PREFIX=RC
